\PYG{n}{fors\PYGZus{}SKgen}\PYG{p}{(}\PYG{n}{SK}\PYG{p}{.}\PYG{n}{seed}\PYG{p}{,}\PYG{+w}{ }\PYG{n}{ADRS}\PYG{p}{,}\PYG{+w}{ }\PYG{n}{idx}\PYG{p}{)}\PYG{+w}{ }\PYG{p}{\PYGZob{}}
\PYG{+w}{  }\PYG{n}{skADRS}\PYG{+w}{ }\PYG{o}{=}\PYG{+w}{ }\PYG{n}{ADRS}\PYG{p}{;}\PYG{+w}{ }\PYG{c+c1}{// copy address to create key generation address }
\PYG{+w}{  }\PYG{n}{skADRS}\PYG{p}{.}\PYG{n}{setType}\PYG{p}{(}\PYG{n}{FORS\PYGZus{}PRF}\PYG{p}{)}\PYG{p}{;}\PYG{+w}{ }
